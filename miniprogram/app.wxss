page {
  min-height: 100%;
  background: #f6f8fb;
  color: #1d2939;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #eaecf0;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
}

.primary-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  background: #1f6f78;
  color: #fff;
  font-size: 30rpx;
}

.primary-btn[disabled] {
  background: #98a2b3;
  color: #fff;
}

.ghost-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  color: #1f6f78;
  border: 1rpx solid #1f6f78;
  background: #fff;
  font-size: 28rpx;
}

.muted {
  color: #667085;
}
