.panel {
  padding: 22rpx;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.tab {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
  color: #475467;
}

.tab.active {
  color: #1f6f78;
  border-color: #1f6f78;
  background: #e8f5f7;
}

input,
textarea {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
}

input {
  height: 78rpx;
}

textarea {
  height: 180rpx;
  padding-top: 18rpx;
}

.init {
  margin-top: 22rpx;
  margin-bottom: 22rpx;
}

.row,
.record {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.action-btn {
  width: 178rpx;
  margin-left: 16rpx;
}

.danger-btn,
.primary-mini {
  width: 112rpx;
  margin-left: 16rpx;
  padding: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}

.danger-btn {
  color: #b42318;
  border: 1rpx solid #fecdca;
  background: #fff;
}

.primary-mini {
  color: #fff;
  background: #1f6f78;
}

.filters {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.chip {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #fff;
  color: #475467;
  font-size: 26rpx;
}

.chip.active {
  color: #1f6f78;
  border-color: #1f6f78;
  background: #e8f5f7;
}

.empty {
  padding: 72rpx 24rpx;
  text-align: center;
  color: #667085;
}

.empty-title {
  margin-bottom: 12rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 700;
}
