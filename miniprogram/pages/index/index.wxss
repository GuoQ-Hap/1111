.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 12rpx;
  color: #60706b;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel,
.result {
  padding: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e1e8e5;
  border-radius: 8rpx;
  box-shadow: 0 14rpx 40rpx rgba(18, 44, 38, 0.06);
}

.field + .field {
  margin-top: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #35443f;
  font-size: 28rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background: #f8fbfa;
  border: 1rpx solid #d9e4e0;
  border-radius: 6rpx;
  color: #17201d;
  font-size: 30rpx;
}

.error {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: #fff5f2;
  border: 1rpx solid #ffd2c5;
  border-radius: 6rpx;
  color: #b42318;
  font-size: 26rpx;
  line-height: 1.45;
}

.query-button {
  margin-top: 32rpx;
  height: 92rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.result {
  margin-top: 32rpx;
}

.result-title {
  margin-bottom: 18rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.result-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f0;
}

.result-label {
  flex: 0 0 150rpx;
  color: #60706b;
  font-size: 28rpx;
}

.result-value {
  flex: 1;
  color: #17201d;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.important {
  color: #0f766e;
  font-size: 40rpx;
}

.reset-button {
  margin-top: 30rpx;
  height: 84rpx;
  background: #ffffff;
  border: 1rpx solid #0f766e;
  color: #0f766e;
  font-size: 30rpx;
  line-height: 84rpx;
}
