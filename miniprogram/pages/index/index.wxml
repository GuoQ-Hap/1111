<view class="page">
  <view class="search card">
    <input value="{{keyword}}" placeholder="搜索书名、作者或 ISBN" confirm-type="search" bindinput="onKeywordInput" bindconfirm="loadBooks" />
    <button class="search-btn" bindtap="loadBooks">搜索</button>
  </view>

  <view class="filters">
    <view class="chip {{status === 'all' ? 'active' : ''}}" data-status="all" bindtap="switchStatus">全部</view>
    <view class="chip {{status === 'available' ? 'active' : ''}}" data-status="available" bindtap="switchStatus">可借</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{books.length === 0}}" class="empty">暂无图书</view>

  <view wx:for="{{books}}" wx:key="_id" class="book card" data-id="{{item._id}}" bindtap="openBook">
    <view class="cover">{{item.coverText}}</view>
    <view class="book-body">
      <view class="book-title">{{item.title}}</view>
      <view class="book-meta">{{item.author}} · {{item.category}}</view>
      <view class="book-meta">馆藏 {{item.total}} 本，当前可借 {{item.available}} 本</view>
    </view>
    <view class="tag {{item.available > 0 ? 'ok' : 'off'}}">{{item.available > 0 ? '可借' : '借完'}}</view>
  </view>
</view>
